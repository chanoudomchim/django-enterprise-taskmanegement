# WorkFlow Enterprise - Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-in-production-workflow-enterprise
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL 16)
POSTGRES_DB=workflow_db
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=workflow_secure_pass_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache (Redis 7 - Django cache only, no Celery)
REDIS_URL=redis://redis:6379/1

# Demo Data System
DEMO_PASSWORD=WorkflowDemo2026!

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@workflow.local
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WorkFlow Enterprise <notifications@workflow.local>

# Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# AI Provider Configuration
AI_PROVIDER=mock
AI_API_KEY=

# Security (Production overrides)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

